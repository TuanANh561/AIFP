# ============================================================================
# AI Life Assistant Platform (AIFP) — File Cấu Hình Môi Trường (.env.example)
# HƯỚNG DẪN CHI TIẾT: Xem tài liệu docs/HUONG_DAN_CAU_HINH_ENV.md
# TUYỆT ĐỐI KHÔNG commit file .env thật lên Git (.gitignore đã chặn sẵn).
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU POSTGRESQL + PGVECTOR
# - Khi tự chạy (Self-hosted / Open-Source bằng Docker): Giữ nguyên POSTGRES_HOST=localhost
#   (hoặc postgres trong docker-compose).
# - Khi Deploy Public / Bán SaaS cho nhiều người dùng: Khuyên dùng Managed PostgreSQL
#   có sẵn pgvector (VD: Supabase.com hoặc Neon.tech miễn phí/trả phí) để có tự động
#   sao lưu (Backup) và không mất dữ liệu khi tắt máy cá nhân.
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aifp_db
POSTGRES_USER=aifp_user
POSTGRES_PASSWORD=change_me_postgres_local_password

# ----------------------------------------------------------------------------
# 2. REDIS 7 (Khóa phân tán Idempotent Scheduler & Rate Limiting)
# - Lấy miễn phí trên Upstash.com (Serverless Redis) khi deploy Cloud, hoặc dùng
#   container redis trong docker-compose.yml.
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_local_password

# ----------------------------------------------------------------------------
# 3. KHÓA BẢO MẬT NỘI BỘ (Tự sinh ngẫu nhiên trên máy của bạn — Miễn phí 100%)
# Cách tạo nhanh trong PowerShell hoặc Terminal:
#   openssl rand -hex 32
# ----------------------------------------------------------------------------
# Chữ ký HMAC-SHA256 bảo vệ giao tiếp nội bộ giữa Spring Boot và Python AI Service:
INTERNAL_SHARED_SECRET=change_me_64_char_hmac_sha256_internal_service_secret_key_2026
# Khóa ký JWT Access Token (15 phút):
JWT_SIGNING_SECRET=change_me_64_char_jwt_hs256_signing_secret_key_for_access_tokens
# Khóa chủ AES-256-GCM (32 ký tự) để mã hóa API Key người dùng & Web Push trên DB:
APP_ENCRYPTION_MASTER_KEY=change_me_32_byte_base64_aes_key

# ----------------------------------------------------------------------------
# 4. ĐA NGUỒN AI & TỰ ĐỘNG XOAY VÒNG KHI HẾT TOKEN (MULTI-KEY & MULTI-MODEL POOL)
# Bạn có thể gắn NHIỀU API KEY (cách nhau bằng dấu phẩy ",") của cả gói Free lẫn Có phí.
# Hệ thống sẽ tự động chuyển đổi (Failover) theo thứ tự:
#   Key 1 -> Key 2 -> Hạ cấp Model Gemini -> Chuyển sang Groq / OpenRouter / OpenAI / Ollama
# ----------------------------------------------------------------------------

# [A] GOOGLE GEMINI (Khuyên dùng chính — Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
# Có thể điền 1 hoặc nhiều key cách nhau bởi dấu phẩy để nhân đôi/nhân ba hạn mức Free:
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GEMINI_API_KEY=your_gemini_key_1

# Chuỗi Model Gemini tự động chuyển đổi khi 1 model bị giới hạn 429 / hết quota ngày:
GEMINI_REASONING_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite
GEMINI_FAST_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash

# [B] GROQ CLOUD (Dự phòng tốc độ cao MIỄN PHÍ — Lấy key tại: https://console.groq.com/keys)
# Tự động kích hoạt khi toàn bộ key Gemini đang chạm giới hạn phút/ngày:
GROQ_API_KEYS=your_groq_free_api_key_1
GROQ_FALLBACK_MODELS=groq/llama-3.3-70b-versatile,groq/llama-3.1-8b-instant

# [C] OPENROUTER (Kho tổng hợp hàng chục model Free & Trả phí — Lấy tại: https://openrouter.ai/keys)
# Hỗ trợ các model miễn phí có hậu tố ":free" hoặc model trả phí theo lượt dùng:
OPENROUTER_API_KEYS=your_openrouter_api_key_1
OPENROUTER_FALLBACK_MODELS=openrouter/google/gemini-2.0-flash-exp:free,openrouter/deepseek/deepseek-chat:free

# [D] OPENAI (Tùy chọn trả phí — Lấy tại: https://platform.openai.com/api-keys)
OPENAI_API_KEYS=your_openai_api_key_here

# [E] OLLAMA LOCAL (Tùy chọn chạy AI Offline miễn phí 100% trên máy chủ khi đứt cáp/hết sạch token)
OLLAMA_BASE_URL=

# ----------------------------------------------------------------------------
# 5. CÔNG CỤ TÌM KIẾM MÃ NGUỒN MỞ (SEARXNG)
# Tự chạy miễn phí qua Docker (cổng 8088), không tốn phí API tìm kiếm mỗi tháng.
# ----------------------------------------------------------------------------
SEARXNG_BASE_URL=http://localhost:8088

# ----------------------------------------------------------------------------
# 6. EMAIL BÁO CÁO & THÔNG BÁO ĐẨY WEB PUSH (iPhone Safari PWA & Web)
# - RESEND_API_KEY: Lấy miễn phí 3.000 email/tháng tại https://resend.com
# - VAPID Keys: Tạo miễn phí bằng lệnh: npx web-push generate-vapid-keys
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_key_here
SMTP_FROM_EMAIL=assistant@aifp.local
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=change_me_vapid_private_key
VAPID_SUBJECT=mailto:security@aifp.local

# ----------------------------------------------------------------------------
# 7. CẤU HÌNH CORS CHO WEB & MOBILE DEPLOY
# ----------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*,http://192.168.*:*,https://*

# ----------------------------------------------------------------------------
# 8. ĐĂNG NHẬP GOOGLE OAUTH2 (CHO PHÉP TẤT CẢ NGƯỜI DÙNG ĐĂNG NHẬP)
# ----------------------------------------------------------------------------
# Lấy miễn phí tại: https://console.cloud.google.com/apis/credentials
# Tạo OAuth 2.0 Client ID (Web application), thêm http://localhost:5173 và domain của bạn
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# ----------------------------------------------------------------------------
# 9. CƠ SỞ DỮ LIỆU ĐÁM MÂY SUPABASE (POSTGRESQL CLOUD - MULTI-TENANT)
# ----------------------------------------------------------------------------
# Lấy chuỗi kết nối tại: Supabase Dashboard > Project Settings > Database > Connection String (URI / JDBC)
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.your_project_ref
# SPRING_DATASOURCE_PASSWORD=your_supabase_db_password
